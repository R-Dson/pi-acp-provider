{
  "name": "pi-acp-provider",
  "version": "1.2.0",
  "description": "Pi agent provider extension that delegates execution to any Agent Client Protocol (ACP) agent, such as GitHub Copilot CLI or Gemini CLI.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "acp",
    "agent-client-protocol"
  ],
  "author": "Robin Davidsson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R-Dson/pi-acp-provider.git"
  },
  "homepage": "https://github.com/R-Dson/pi-acp-provider#readme",
  "bugs": {
    "url": "https://github.com/R-Dson/pi-acp-provider/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec test/",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
